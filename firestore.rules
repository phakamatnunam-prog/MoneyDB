rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (data.type == 'income' || data.type == 'expense')
        && (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 200))
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.month is string && data.month.matches('^\\d{4}-\\d{2}$')
        && (!('paymentMethod' in data) || (data.paymentMethod in ['cash', 'transfer', 'credit_card', 'other']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 150
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('monthlyBudget' in data) || ((data.monthlyBudget is int || data.monthlyBudget is float) && data.monthlyBudget >= 0 && data.monthlyBudget <= 1000000000))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'description', 'date', 'month', 'paymentMethod', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(transactionId)
        && existing().userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'monthlyBudget', 'currency', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
